# Data & Large Parquet files
data/*.parquet
data/*.bak
data/raw/*
!data/raw/btc_provided
!data/raw/btc_provided/**
data/processed/*
data/indices/*
!data/**/.gitkeep
*.jsonl
*.xml
*.pkl
*.db
*.sqlite

# Submissions & heavy artifacts
submission*.*
*.zip

# Nested Repositories
repos/

# HuggingFace & Caches
hf_cache/
.cache/
.pytest_cache/
data/model_cache/

# Generated analyses and experiment workspaces
data/audits/
data/exp*/
data/kaggle_inputs/
data/query_translations/
data/qwen3*/
data/reference/
*.npy
*.log
tmp/
tmp_*/
submission*_package/

# Recoverable local archive for retired one-off code
archive/one_off_code_*/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Jupyter Notebook
.ipynb_checkpoints

# IDEs
.idea/
.vscode/
*.swp
*.swo

