# Data & Large Parquet files
data/*.parquet
data/raw/*
!data/raw/btc_provided
!data/raw/btc_provided/**
data/processed/*
data/indices/*
!data/**/.gitkeep
*.jsonl
*.xml
*.pkl
*.db
*.sqlite

# Submissions & heavy artifacts
submission*.*
*.zip

# Nested Repositories
repos/

# HuggingFace & Caches
hf_cache/
.cache/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Jupyter Notebook
.ipynb_checkpoints

# IDEs
.idea/
.vscode/
*.swp
*.swo

# Allow dev set
!data/dev_set/
!data/dev_set/*.csv
!data/dev_set/*.json
